# Skopiuj wybrane ustawienia do .env. Nie nadpisuj swoich danych dostępowych.
# PD_* ma pierwszeństwo przed starymi nazwami. Zmiany wymagają restartu.
# Godziny: HH:MM, przedziały przez północ działają; start == koniec = cała doba.
# Każda akcja następuje dopiero po potwierdzonym wykryciu, nie od samej godziny.


# --- Model YOLO ---
# Poziom logów C++ PyTorch: INFO, WARNING, ERROR albo FATAL.
PD_TORCH_CPP_LOG_LEVEL=ERROR
# Ścieżka wag; względna względem repozytorium.
PD_MODEL_PATH=best.pt
# Urządzenie YOLO, np. cpu albo 0 dla GPU.
PD_MODEL_DEVICE=cpu
# Rozmiar wejścia modelu.
PD_MODEL_IMGSZ=960
# Minimalna pewność detekcji.
PD_MODEL_CONFIDENCE=0.5
# Próg NMS YOLO; niezależny od MASK_IOU_THRESHOLD.
PD_MODEL_IOU=0.5
# Klasy rozdzielone przecinkami; puste = wszystkie.
PD_MODEL_CLASSES=0
# Szczegółowe logi predykcji YOLO.
PD_MODEL_VERBOSE=false

# --- Zdjęcia i katalogi ---
# Jakość zapisywanych zdjęć JPEG, 0..100.
PD_JPEG_QUALITY=95
# Oryginały w buforze.
PD_BUFFER_DIR=files/buffer
# Maskowane predykcje YOLO w buforze.
PD_BUFFER_ANNOTATED_DIR=files/buff_annot
# Docelowe oryginały po potwierdzeniu.
PD_CLEAR_DIR=files/clear
# Docelowe predykcje z maską i ramkami; te zdjęcia idą na Telegram.
PD_ANNOTATED_DIR=files/annotated
# Odrzucone klatki.
PD_DAMAGED_DIR=files/damaged
# Grubość ramki YOLO.
PD_ANNOTATION_LINE_WIDTH=1
# Rozmiar tekstu YOLO.
PD_ANNOTATION_FONT_SIZE=1
# Limit plików przy ręcznym/cronowym uruchomieniu cleanup.sh.
PD_CLEANUP_MAX_FILES=1000
# Diagnostyczne logi pętli, historii i bufora.
PD_DEBUG_LOGS=true

# --- Połączenia i dane dostępowe ---
# Adres strumienia RTSP (może zawierać hasło; nie publikuj .env).
PD_RTSP_URL=
# Adres kamery Reolink.
PD_REOLINK_HOST=
# Użytkownik kamery.
PD_REOLINK_USER=
# Hasło kamery.
PD_REOLINK_PASSWORD=
# Token bota Telegram.
PD_TELEGRAM_TOKEN=
# Identyfikator czatu Telegram.
PD_TELEGRAM_CHAT_ID=

# --- Harmonogramy: czas lokalny, początek włącznie, koniec wyłącznie ---
# Strefa IANA; uwzględnia zmianę czasu.
PD_TIMEZONE=Europe/Warsaw
# Włącz przetwarzanie detekcji.
PD_DETECTION_ENABLED=true
# Ogólne dopuszczalne godziny pracy detektora.
PD_DETECTION_START=00:00
# Koniec ogólnego przedziału pracy detektora.
PD_DETECTION_END=24:00
# Detekcja/zapis także gdy żadna akcja nie jest obecnie dozwolona.
PD_RUN_WITHOUT_ACTIONS=false
# Światło po potwierdzonym wykryciu.
PD_LIGHT_ENABLED=true
# Początek godzin reakcji światłem, np. 20:00.
PD_LIGHT_START=01:00
# Koniec godzin światła; może być wcześniej niż początek (przez północ).
PD_LIGHT_END=24:00
# Czas świecenia po wykryciu; skracany po zamknięciu harmonogramu.
PD_LIGHT_DURATION_SECONDS=30
# Włącz zdjęcia/powiadomienia.
PD_TELEGRAM_ENABLED=true
# Początek godzin Telegrama.
PD_TELEGRAM_START=01:00
# Koniec godzin Telegrama.
PD_TELEGRAM_END=24:00
# Włącz syrenę kamery.
PD_SIREN_ENABLED=true
# Początek godzin syreny.
PD_SIREN_START=01:00
# Koniec godzin syreny.
PD_SIREN_END=24:00
# Czas syreny po wykryciu; skracany po zamknięciu harmonogramu.
PD_SIREN_DURATION_SECONDS=30
# Co ile sekund sprawdzać koniec harmonogramu aktywnego wyjścia.
PD_ACTION_POLL_SECONDS=0.5

# --- Pętla i strumień RTSP ---
# Przerwa PO predykcji; dochodzi do czasu obliczeń CPU.
PD_LOOP_DELAY_SECONDS=0.3
# Przerwa poza godzinami działania.
PD_IDLE_SLEEP_SECONDS=60
# Przerwa, gdy kamera nie zwróciła klatki.
PD_NO_FRAME_SLEEP_SECONDS=0.8
# Okresowe odnowienie połączenia (21600 s = 6 h).
PD_RTSP_RECONNECT_SECONDS=21600
# Ponów połączenie po przekroczeniu tej liczby błędnych odczytów.
PD_RTSP_MAX_FAILED_READS=5
# Przerwa między próbami ponownego połączenia.
PD_RTSP_RETRY_SECONDS=2
# Żądany bufor VideoCapture przy połączeniu.
PD_RTSP_BUFFER_SIZE=1
# Numer kanału kamery.
PD_REOLINK_CHANNEL=0
# Odstęp ponawiania połączenia API kamery.
PD_REOLINK_RETRY_SECONDS=5
# Odstęp kontroli połączenia API kamery.
PD_REOLINK_WATCHDOG_SECONDS=60

# --- Potwierdzanie alarmu, analiza ruchu i stare filtrowanie statyczne ---
# Minimalna liczba kwalifikujących się klatek do reakcji.
PD_ALARM_MIN_DETECTIONS=7
# Okno klatek licznika alarmu.
PD_ALARM_WINDOW_SECONDS=60
# Liczba ostatnich środków w dotychczasowym filtrze ruchu.
PD_MOTION_HISTORY_SIZE=5
# Odrzuć ruch o mniejszej średniej odległości.
PD_MOTION_MIN_AVERAGE_PX=3
# Odrzuć ruch o większej średniej odległości.
PD_MOTION_MAX_AVERAGE_PX=480
# Maksymalny ostatni skok środka ramki.
PD_MOTION_MAX_JUMP_PX=550
# Wymagany czas nieruchomości starego filtra.
PD_STATIC_SECONDS=30
# Czas ignorowania przez stary filtr.
PD_STATIC_IGNORE_SECONDS=120
# Odległość dopasowania środków w starym filtrze.
PD_STATIC_MATCH_DISTANCE_PX=60
# Rozrzut środków uznawany za nieruchomy w starym filtrze.
PD_STATIC_MAX_MOVE_PX=3
# Minimalne obserwacje starego filtra.
PD_STATIC_MIN_OBSERVATIONS=3
# Tolerancja kompletności historii starego filtra.
PD_STATIC_TIME_TOLERANCE_SECONDS=2
# Dodatkowy czas pamiętania śladu przez stary filtr.
PD_STATIC_RETENTION_EXTRA_SECONDS=60

# --- Jakość obrazu i odrzucanie uszkodzonych klatek ---
# Historia średnich zmian pikseli.
PD_PIXEL_HISTORY_SIZE=10
# Historia entropii klatki.
PD_ENTROPY_HISTORY_SIZE=10
# Próg odchylenia średnich różnic pikseli od historii.
PD_PIXEL_CHANGE_THRESHOLD=1.6
# Próg odchylenia entropii; obecnie służy do diagnostyki.
PD_ENTROPY_CHANGE_THRESHOLD=1
# Przerwa po odrzuceniu uszkodzonej klatki.
PD_DAMAGED_FRAME_SLEEP_SECONDS=1

# --- Maskowanie statycznych fałszywych detekcji ---
# Zgodne obserwacje przed utworzeniem maski.
PD_MASK_REQUIRED_HITS=4
# Okno zbierania obserwacji.
PD_MASK_WINDOW_SECONDS=20
# Czas życia maski; kolejne wykrycia go nie przedłużają.
PD_MASK_DURATION_SECONDS=120
# Bok czarnego kwadratu w oryginalnej rozdzielczości.
PD_MASK_PATCH_SIZE_PX=15
# Tolerancja środka i rozrzutu środków (na każdej osi).
PD_MASK_CENTER_TOLERANCE_PX=12
# Względna tolerancja szerokości i wysokości (0.35 = 35%).
PD_MASK_SIZE_TOLERANCE=0.35
# Spójne przesunięcie od tej wartości wyklucza nieruchomość.
PD_MASK_MOVEMENT_THRESHOLD_PX=4
# Odstęp kontroli bez czarnych łat; bez dodatkowej predykcji.
PD_MASK_PROBE_INTERVAL_SECONDS=15
# Kolejne puste kontrole usuwające maskę.
PD_MASK_MISSING_PROBES=2
# Minimalne IoU już zapamiętanej ramki; mniej = luźniej.
PD_MASK_IOU_THRESHOLD=0.45
# Wypisz utworzenie maski.
PD_MASK_LOG_EVENTS=true
# Dolna granica tolerancji wymiarów ramki w px.
PD_MASK_MIN_SIZE_TOLERANCE_PX=4
# Minimalny stosunek przesunięcia do całej drogi, aby uznać ruch za spójny.
PD_MASK_DIRECTIONALITY=0.8
# Maksymalna liczba obserwacji jednego kandydata w pamięci.
PD_MASK_HISTORY_LIMIT=256

# --- Wysyłka Telegram i kolejka ---
# Wyślij pierwszą i ostatnią klatkę potwierdzonego zdarzenia; false = wszystkie.
PD_TELEGRAM_SEND_FIRST_LAST_ONLY=true
# Przerwa przed pierwszą próbą wysłania zdjęcia.
PD_TELEGRAM_SEND_DELAY_SECONDS=0.1
# Przerwa przed ponowieniem wysyłki.
PD_TELEGRAM_RETRY_SECONDS=1
# Maksymalna liczba prób wysyłki.
PD_TELEGRAM_ATTEMPTS=2
# Limit czasu pojedynczego żądania HTTP.
PD_TELEGRAM_TIMEOUT_SECONDS=15
# Odstęp starej pomocniczej funkcji send_notification (nie bufora zdjęć).
PD_TELEGRAM_MESSAGE_COOLDOWN_SECONDS=2
# Oczekiwanie wątku kolejki na nowe zdjęcie.
PD_QUEUE_TIMEOUT_SECONDS=1
